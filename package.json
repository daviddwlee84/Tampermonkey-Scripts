{
  "name": "tampermonkey-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Da-Wei Lee's userscripts + a Traditional Chinese guide to writing them",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/daviddwlee84/Tampermonkey-Scripts"
  },
  "author": "Da-Wei Lee",
  "license": "MIT",
  "scripts": {
    "new": "node scripts/new-script.mjs",
    "check": "node scripts/check-meta.mjs",
    "index": "node scripts/build-index.mjs",
    "index:check": "node scripts/build-index.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run index:check",
    "preview": "node scripts/preview.mjs",
    "test:chatgpt-export": "node --test tests/chatgpt-export-markdown.test.mjs",
    "build:chat-explorer": "node scripts/build-chat-explorer.mjs",
    "test:chat-explorer": "node --test tests/conversation-archive.test.mjs tests/conversation-explorer.test.mjs",
    "test:page-reader": "node --test tests/page-reader-markdown.test.mjs",
    "test:media-helper": "node --test tests/media-helper.test.mjs",
    "test:vim-navigation": "node --test tests/vim-navigation.test.mjs",
    "test:vimium-c-companion": "node --test tests/vimium-c-companion-reference.test.mjs tests/vimium-c-companion.test.mjs",
    "dino": "node scripts/dino-server.mjs",
    "test:dino-ai": "node --test tests/dino-ai-lab.test.mjs",
    "benchmark:dino": "node scripts/dino-benchmark.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "playwright": "^1.62.1"
  }
}
